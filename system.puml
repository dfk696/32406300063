@startuml
left to right direction
skinparam packageStyle rectangle

actor "读者" as reader
actor "图书管理员" as admin

rectangle "借阅管理子系统" {
  usecase "借阅图书" as UC1
  usecase "归还图书" as UC2
  usecase "续借图书" as UC3
  usecase "缴纳罚金" as UC4
  usecase "处理逾期" as UC5
}

reader --> UC1
reader --> UC2
reader --> UC3
admin --> UC4
admin --> UC5

UC1 .> UC4 : <<extend>> (若逾期未还)
@enduml